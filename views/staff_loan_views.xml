<odoo>
    <record id="view_staff_loan_list" model="ir.ui.view">
        <field name="name">staff.loan.list</field>
        <field name="model">staff.loan</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-muted="state in ('closed', 'cancelled')">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="loan_date"/>
                <field name="loan_amount" sum="Total Loan Amount"/>
                <field name="total_interest" sum="Total Interest"/>
                <field name="outstanding_balance" sum="Outstanding"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state in ('running', 'disbursed')" decoration-muted="state == 'closed'" decoration-danger="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_staff_loan_line_list" model="ir.ui.view">
        <field name="name">staff.loan.line.list</field>
        <field name="model">staff.loan.line</field>
        <field name="arch" type="xml">
            <list string="Staff Loan lines" editable="bottom" create="0" delete="0" limit="80" decoration-danger="is_overdue" decoration-info="not is_repayment_move_posted">
                <field name="sequence" string="#" width="30px" optional="hide"/>
                <field name="loan_id" optional="hide"/>
                <field name="employee_id" optional="hide"/>
                <field name="due_date" string="Due Date"/>
                <field name="principal" string="Principals" sum="Total principals"/>
                <field name="interest" string="Interests" sum="Total interests"/>
                <field name="payment" string="Payments" sum="Total payments"/>
                <field name="balance" string="Outstanding Balance"/>
                <field name="state" string="Status" widget="badge" decoration-info="state == 'unpaid'" decoration-success="state == 'paid'" decoration-warning="state == 'exception'"/>
                <button name="action_collect_wizard" string="Collect" type="object" class="btn-link" invisible="state != 'unpaid'"/>
                <button name="action_manual_exception_wizard" string="Exception" type="object" class="btn-link" invisible="state == 'paid' or state == 'exception'"/>
            </list>
        </field>
    </record>

    <record id="view_staff_loan_outstanding_move_list" model="ir.ui.view">
        <field name="name">staff.loan.outstanding.account.move.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Outstanding Balance" create="0" edit="0" delete="0" default_order="date,id">
                <field name="date" string="Date"/>
                <field name="staff_loan_due_date" string="Due Date"/>
                <field name="name" string="Number"/>
                <field name="ref" string="Reference"/>
                <field name="journal_id" string="Journal"/>
                <field name="staff_loan_settlement_amount" string="Settlement" sum="Total Settlement"/>
                <field name="staff_loan_outstanding_balance" string="Outstanding Balance"/>
            </list>
        </field>
    </record>

    <record id="view_staff_loan_account_move_list" model="ir.ui.view">
        <field name="name">staff.loan.account.move.list</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">date,name,ref</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_staff_loan_search" model="ir.ui.view">
        <field name="name">staff.loan.search</field>
        <field name="model">staff.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter string="Current" name="current" domain="[('state', 'in', ('draft', 'approved', 'disbursed', 'running'))]"/>
                <filter string="Running" name="running" domain="[('state', '=', 'running')]"/>
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter string="Staff" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_staff_loan_form" model="ir.ui.view">
        <field name="name">staff.loan.form</field>
        <field name="model">staff.loan</field>
        <field name="arch" type="xml">
            <form string="Staff Loan">
                <header>
                    <button name="action_reset" string="Reset" type="object" class="btn-secondary" invisible="state != 'draft' or not line_ids" groups="base.group_system"/>
                    <button name="action_approve_wizard" string="Approve" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_disburse_wizard" string="Disburse" type="object" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_update_exception_schedule" string="Update Schedule" type="object" class="btn-secondary" invisible="state not in ('running', 'disbursed') or not exception_update_pending"/>
                    <button name="action_full_settlement_wizard" string="Full Settlement" type="object" class="btn-secondary" invisible="state not in ('running', 'disbursed') or outstanding_balance == 0"/>
                    <button name="action_compute_schedule" string="Compute" type="object" class="btn-secondary" invisible="state != 'draft' or line_ids"/>
                    <button name="action_close_wizard" string="Close" type="object" class="btn-secondary" invisible="state != 'running'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state != 'running'" groups="base.group_system"/>
                    <button name="action_cancel_wizard" string="Cancel" type="object" class="btn-secondary" invisible="state not in ('draft', 'approved')" groups="base.group_system"/>
                    <button name="action_set_to_draft" string="Set to Draft" type="object" class="btn-secondary" invisible="state != 'cancelled'" groups="base.group_system"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,disbursed,running,closed,cancelled"/>
                </header>
                <sheet>
                    <field name="exception_update_pending" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_open_entries" icon="fa-bars">
                            <field name="posted_entry_count" string="Posted Entries" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_open_outstanding_lines" icon="fa-money">
                            <field name="outstanding_balance" string="Outstanding" widget="monetary"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_open_documents" icon="fa-file-text-o">
                            <field name="document_count" string="Documents" widget="statinfo"/>
                        </button>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="department_id"/>
                            <field name="loan_amount" readonly="state != 'draft'"/>
                            <field name="interest_type" readonly="state != 'draft'"/>
                            <field name="payment_anchor" readonly="state != 'draft'"/>
                            <field name="interest_rate" readonly="state != 'draft'"/>
                            <field name="total_interest"/>
                            <field name="outstanding_balance"/>
                        </group>
                        <group>
                            <field name="granter_id" readonly="state not in ('draft', 'approved')"/>
                            <field name="granter_department_id"/>
                            <field name="loan_date" readonly="state != 'draft'"/>
                            <label for="duration" string="Duration"/>
                            <div>
                                <field name="duration" class="oe_inline" readonly="state != 'draft'"/>
                                <span class="oe_inline" invisible="duration == 1"> months</span>
                                <span class="oe_inline" invisible="duration != 1"> month</span>
                            </div>
                            <field name="payment_frequency" readonly="state != 'draft'"/>
                            <field name="disbursement_date" readonly="1"/>
                            <field name="reference"/>
                            <field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Repayment Schedule">
                            <field name="line_ids" readonly="state != 'draft'"/>
                        </page>
                        <page string="Loan Settings">
                            <group>
                                <group>
                                    <field name="receivable_account_id" readonly="state not in ('draft', 'approved')" options="{'no_open': True}"/>
                                    <field name="interest_income_account_id" readonly="state not in ('draft', 'approved')" options="{'no_open': True}"/>
                                    <field name="disbursement_account_id" readonly="state not in ('draft', 'approved')" options="{'no_open': True}"/>
                                    <field name="collection_account_id" readonly="state not in ('draft', 'approved')" options="{'no_open': True}"/>
                                    <field name="deferred_account_id" readonly="state not in ('draft', 'approved')" options="{'no_open': True}"/>
                                </group>
                                <group>
                                    <field name="disbursement_journal_id" readonly="state not in ('draft', 'approved')"/>
                                    <field name="disbursement_move_id"/>
                                    <field name="skip_until" readonly="state != 'draft'" help="Leave empty to use the loan date month for the first payment date. Set a later date to postpone the first payment month."/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Internal loan purpose, repayment conditions, management instructions, or amendments."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_staff_loan_pivot" model="ir.ui.view">
        <field name="name">staff.loan.pivot</field>
        <field name="model">staff.loan</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="employee_id" type="row"/>
                <field name="state" type="col"/>
                <field name="loan_amount" type="measure"/>
                <field name="outstanding_balance" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_staff_loan" model="ir.actions.act_window">
        <field name="name">Staff Loans</field>
        <field name="path">staff-loan</field>
        <field name="res_model">staff.loan</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="view_staff_loan_search"/>
        <field name="context">{'search_default_current': 1}</field>
    </record>

    <record id="action_staff_loan_line" model="ir.actions.act_window">
        <field name="name">Staff Loan Installments</field>
        <field name="res_model">staff.loan.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_staff_loan_document_upload" model="ir.actions.act_window">
        <field name="name">Upload Document</field>
        <field name="res_model">staff.loan.document.wizard</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>
    </record>

    <record id="view_staff_loan_attachment_list" model="ir.ui.view">
        <field name="name">staff.loan.attachment.list</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <list string="Documents" edit="0" js_class="staff_loan_attachment_list">
                <field name="name"/>
                <field name="create_date"/>
                <field name="create_uid"/>
                <field name="file_size"/>
                <field name="mimetype"/>
            </list>
        </field>
    </record>

    <record id="view_staff_loan_attachment_kanban" model="ir.ui.view">
        <field name="name">staff.loan.attachment.kanban</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" eval="False"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <kanban edit="false" import="false" js_class="staff_loan_attachment_kanban">
                <field name="id"/>
                <field name="mimetype"/>
                <field name="type"/>
                <templates>
                    <t t-name="menu">
                        <a t-attf-href="/web/content/ir.attachment/#{record.id.raw_value}/datas?download=true" download="" class="dropdown-item">Download</a>
                        <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                    </t>
                    <t t-name="card" class="o_kanban_attachment flex-row">
                        <aside class="o_kanban_image m-1">
                            <div class="o_kanban_image_wrapper d-flex align-items-center justify-content-center">
                                <t t-set="webimage" t-value="new RegExp('image.*(gif|jpeg|jpg|png|webp)').test(record.mimetype.value)"/>
                                <div t-if="record.type.raw_value == 'url'" class="fa fa-link fa-3x text-muted" aria-label="Image is a link"/>
                                <img t-elif="webimage" t-attf-src="/web/image/#{record.id.raw_value}" width="100" height="100" alt="Document" class="o_attachment_image"/>
                                <div t-else="!webimage" class="o_image o_image_thumbnail" t-att-data-mimetype="record.mimetype.value"/>
                            </div>
                        </aside>
                        <main class="ms-1">
                            <div class="o_kanban_details_wrapper d-flex flex-column">
                                <field name="name" class="text-truncate fw-bold fs-5"/>
                                <div class="d-flex flex-grow-1 align-items-center">
                                    <t t-if="record.type.raw_value == 'url'">
                                        <i class="fa fa-globe" aria-label="Document url"/> <field name="url" widget="url"/>
                                    </t>
                                </div>
                                <div class="d-flex">
                                    <field name="create_date"/>
                                    <field name="create_uid" widget="many2one_avatar_user" class="ms-auto"/>
                                </div>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_staff_loan_attachment_form" model="ir.ui.view">
        <field name="name">staff.loan.attachment.form</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <form string="Upload Document">
                <sheet>
                    <field name="type" invisible="1"/>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Document Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="datas" filename="name"/>
                            <field name="mimetype" readonly="1"/>
                            <field name="file_size" readonly="1"/>
                        </group>
                        <group string="Linked To">
                            <field name="res_model" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                            <field name="res_name" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="History">
                            <field name="create_uid" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <group invisible="not staff_loan_is_pdf">
                        <field name="staff_loan_preview_html" widget="html" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_staff_loan_attachment" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="views" eval="[(ref('view_staff_loan_attachment_kanban'), 'kanban'), (ref('view_staff_loan_attachment_list'), 'list'), (ref('view_staff_loan_attachment_form'), 'form')]"/>
        <field name="help" eval="False"/>
    </record>

    <menuitem id="menu_staff_loan_root" name="Staff Loans" parent="accountant.account_assets_liabilities_menu" action="action_staff_loan" sequence="63" groups="account.group_account_readonly"/>
    <menuitem id="menu_staff_loan" name="Staff Loans" parent="menu_staff_loan_root" action="action_staff_loan" sequence="10" groups="account.group_account_readonly"/>
    <menuitem id="menu_staff_loan_lines" name="Installments" parent="menu_staff_loan_root" action="action_staff_loan_line" sequence="20" groups="base.group_no_one"/>
    <record id="menu_staff_loan" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="menu_staff_loan_lines" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
